@host = http://localhost:3000/api

# ===== Аутентификация =====

### Регистрация (поле role игнорируется — новые пользователи всегда получают роль user)
POST {{host}}/auth/register
Content-Type: application/json

{ "email": "ivan@example.com", "password": "secret12", "role": "admin" }

### Повторная регистрация того же email -> 409
POST {{host}}/auth/register
Content-Type: application/json

{ "email": "ivan@example.com", "password": "secret12" }

### Слишком короткий пароль -> 400
POST {{host}}/auth/register
Content-Type: application/json

{ "email": "petr@example.com", "password": "123" }

### Неверный пароль -> 401
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "ivan@example.com", "password": "wrong" }

### Вход покупателя
# @name userLogin
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "ivan@example.com", "password": "secret12" }

### Вход администратора (создаётся сидом)
# @name adminLogin
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "admin@shop.local", "password": "Admin123!" }

###
@userToken = {{userLogin.response.body.data.token}}
@adminToken = {{adminLogin.response.body.data.token}}

### Профиль с валидным токеном -> 200
GET {{host}}/profile
Authorization: Bearer {{userToken}}

### Профиль без токена -> 401
GET {{host}}/profile

### Профиль с испорченным токеном -> 401
GET {{host}}/profile
Authorization: Bearer invalid.token.value

# ===== Товары (чтение — всем, изменение — только admin) =====

###
GET {{host}}/products

###
GET {{host}}/products?category=jeans&size=L

### Поиск по названию/цвету без учёта регистра (лаб. №25)
GET {{host}}/products?search=джин

### Пагинация: вторая страница по 6 товаров (meta.total, meta.hasMore)
GET {{host}}/products?limit=6&offset=6

### Некорректный limit -> 400
GET {{host}}/products?limit=0

###
GET {{host}}/products/999

###
GET {{host}}/products/abc

### Покупатель не может добавлять товары -> 403
POST {{host}}/products
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "title": "Куртка бомбер",
  "category": "jackets",
  "sizes": ["S", "M", "L"],
  "color": "хаки",
  "price": 129.9,
  "stock": 10
}

### Администратор добавляет товар -> 201
# @name createdProduct
POST {{host}}/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Куртка бомбер",
  "category": "jackets",
  "sizes": ["S", "M", "L"],
  "color": "хаки",
  "price": 129.9,
  "stock": 10
}

###
@productId = {{createdProduct.response.body.data.id}}

###
POST {{host}}/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "title": "Куртка бомбер" }

###
PUT {{host}}/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Куртка бомбер зимняя",
  "category": "jackets",
  "sizes": ["M", "L"],
  "color": "чёрный",
  "price": 179.9,
  "stock": 6
}

# ===== Корзина (у каждого пользователя своя) =====

### Без токена -> 401
GET {{host}}/cart

###
GET {{host}}/cart
Authorization: Bearer {{userToken}}

###
POST {{host}}/cart/items
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "productId": {{productId}}, "size": "L", "quantity": 2 }

###
POST {{host}}/cart/items
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "productId": {{productId}}, "size": "XXL", "quantity": 1 }

###
POST {{host}}/cart/items
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "productId": {{productId}}, "size": "M", "quantity": 99 }

###
PUT {{host}}/cart/items/1
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "quantity": 3 }

### Смена размера позиции (лаб. №25); размер должен быть у товара и не дублировать другую позицию
PUT {{host}}/cart/items/1
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "size": "M" }

### Количество больше остатка на складе -> 409
PUT {{host}}/cart/items/1
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "quantity": 9999 }

###
DELETE {{host}}/cart/items/1
Authorization: Bearer {{userToken}}

# ===== Заказы =====

### Оформление заказа (email по умолчанию берётся из токена)
# @name createdOrder
POST {{host}}/orders
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "customer": {
    "name": "Иван Петров",
    "phone": "+375291234567",
    "address": "г. Минск, ул. Независимости, 25, кв. 14"
  }
}

###
@orderId = {{createdOrder.response.body.data.id}}

### Покупатель видит только свои заказы
GET {{host}}/orders
Authorization: Bearer {{userToken}}

### Администратор видит все заказы
GET {{host}}/orders?status=new
Authorization: Bearer {{adminToken}}

### Покупатель не может менять статус -> 403
PATCH {{host}}/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "status": "paid" }

###
PATCH {{host}}/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "status": "paid" }

###
PATCH {{host}}/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "status": "wrong" }

###
DELETE {{host}}/orders/{{orderId}}
Authorization: Bearer {{adminToken}}

# ===== Пользователи (только admin) =====

### Покупатель -> 403
GET {{host}}/users
Authorization: Bearer {{userToken}}

###
GET {{host}}/users
Authorization: Bearer {{adminToken}}

### Назначить роль (подставьте id пользователя)
PATCH {{host}}/users/2/role
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "role": "admin" }

###
DELETE {{host}}/products/{{productId}}
Authorization: Bearer {{adminToken}}

###
GET {{host}}/unknown

###
GET http://localhost:3000/


# ===== MongoDB (лаб. №26): /api/mongo =====
# Перед запуском: MONGO_URI в .env и npm run mongo:seed. Токены берутся из запросов входа выше.

### Каталог MongoDB с пагинацией
# @name mongoProducts
GET {{host}}/mongo/products?limit=3&offset=0

@mongoProductId = {{mongoProducts.response.body.data.0._id}}

### Поиск по массиву tags (tags содержит "деним")
GET {{host}}/mongo/products?tag=деним

### Поиск по массиву sizes + фильтр по цене
GET {{host}}/mongo/products?size=XL&maxPrice=100

### Товар по ObjectId (вложенные reviews, виртуальные поля rating и finalPrice)
GET {{host}}/mongo/products/{{mongoProductId}}

### Некорректный ObjectId -> 400
GET {{host}}/mongo/products/123

### Создать товар (admin)
# @name mongoCreatedProduct
POST {{host}}/mongo/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "title": "Шорты карго", "category": "shorts", "sizes": ["S", "M", "L"], "color": "бежевый", "price": 45, "stock": 5, "tags": ["лето", "хлопок"] }

@mongoNewProductId = {{mongoCreatedProduct.response.body.data._id}}

### Ошибка валидации схемы (пустые sizes, отрицательная цена) -> 400
POST {{host}}/mongo/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "title": "Bad", "category": "shorts", "sizes": [], "price": -1 }

### Обновить товар (findByIdAndUpdate)
PUT {{host}}/mongo/products/{{mongoNewProductId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "title": "Шорты карго Relaxed", "category": "shorts", "sizes": ["M", "L"], "price": 49.9, "stock": 7, "discountPercent": 15 }

### Добавить отзыв во вложенный массив reviews ($push)
# @name mongoReview
POST {{host}}/mongo/products/{{mongoProductId}}/reviews
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "rating": 4, "comment": "Хорошо сидит, ткань плотная" }

### Удалить свой отзыв ($pull)
DELETE {{host}}/mongo/products/{{mongoProductId}}/reviews/{{mongoReview.response.body.data.review._id}}
Authorization: Bearer {{userToken}}

### Добавить в корзину (новая позиция -> $push, upsert корзины)
POST {{host}}/mongo/cart/items
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "productId": "{{mongoProductId}}", "size": "M", "quantity": 1 }

### Повторно тот же товар и размер -> $inc по items.$.quantity
# @name mongoCartAdd
POST {{host}}/mongo/cart/items
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "productId": "{{mongoProductId}}", "size": "M", "quantity": 2 }

@mongoCartItemId = {{mongoCartAdd.response.body.data.items.0._id}}

### Корзина (populate items.product, virtual total)
GET {{host}}/mongo/cart
Authorization: Bearer {{userToken}}

### Изменить количество позиции (позиционный оператор $set items.$.quantity)
PATCH {{host}}/mongo/cart/items/{{mongoCartItemId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "quantity": 2 }

### Превышение остатка -> 409
PATCH {{host}}/mongo/cart/items/{{mongoCartItemId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "quantity": 999 }

### Оформить заказ из корзины
# @name mongoOrder
POST {{host}}/mongo/orders
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "customer": { "name": "Иван Петров", "phone": "+375291234567", "address": "г. Минск, ул. Независимости, 25" } }

@mongoOrderId = {{mongoOrder.response.body.data._id}}

### Мои заказы, поиск по вложенному полю customer.name
GET {{host}}/mongo/orders?customer=иван
Authorization: Bearer {{userToken}}

### Заказ по id
GET {{host}}/mongo/orders/{{mongoOrderId}}
Authorization: Bearer {{userToken}}

### Смена статуса + $push в statusHistory (admin)
PATCH {{host}}/mongo/orders/{{mongoOrderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "status": "paid" }

### Покупатель меняет статус -> 403
PATCH {{host}}/mongo/orders/{{mongoOrderId}}/status
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "status": "delivered" }

### Полное обновление заказа (admin)
PUT {{host}}/mongo/orders/{{mongoOrderId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "customer": { "name": "Иван Петров", "email": "ivan@example.com", "address": "г. Минск, пр. Победителей, 1" },
  "status": "shipped",
  "items": [{ "productId": "{{mongoProductId}}", "title": "Футболка Oversize", "size": "L", "price": 39.9, "quantity": 2 }]
}

### Статистика заказов (aggregation pipeline, admin)
GET {{host}}/mongo/orders/stats
Authorization: Bearer {{adminToken}}

### Удалить заказ — в ответе удалённый документ (admin)
DELETE {{host}}/mongo/orders/{{mongoOrderId}}
Authorization: Bearer {{adminToken}}

### Удалить товар — позиции с ним удаляются из всех корзин (admin)
DELETE {{host}}/mongo/products/{{mongoNewProductId}}
Authorization: Bearer {{adminToken}}

### Очистить корзину
DELETE {{host}}/mongo/cart
Authorization: Bearer {{userToken}}