@host = http://localhost:3000/api

# ===== Аутентификация =====

### Регистрация (поле role игнорируется — новые пользователи всегда получают роль user)
POST {{host}}/auth/register
Content-Type: application/json

{ "email": "ivan@example.com", "password": "secret12", "role": "admin" }

### Повторная регистрация того же email -> 409
POST {{host}}/auth/register
Content-Type: application/json

{ "email": "ivan@example.com", "password": "secret12" }

### Слишком короткий пароль -> 400
POST {{host}}/auth/register
Content-Type: application/json

{ "email": "petr@example.com", "password": "123" }

### Неверный пароль -> 401
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "ivan@example.com", "password": "wrong" }

### Вход покупателя
# @name userLogin
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "ivan@example.com", "password": "secret12" }

### Вход администратора (создаётся сидом)
# @name adminLogin
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "admin@shop.local", "password": "Admin123!" }

###
@userToken = {{userLogin.response.body.data.token}}
@adminToken = {{adminLogin.response.body.data.token}}

### Профиль с валидным токеном -> 200
GET {{host}}/profile
Authorization: Bearer {{userToken}}

### Профиль без токена -> 401
GET {{host}}/profile

### Профиль с испорченным токеном -> 401
GET {{host}}/profile
Authorization: Bearer invalid.token.value

# ===== Товары (чтение — всем, изменение — только admin) =====

###
GET {{host}}/products

###
GET {{host}}/products?category=jeans&size=L

### Поиск по названию/цвету без учёта регистра (лаб. №25)
GET {{host}}/products?search=джин

### Пагинация: вторая страница по 6 товаров (meta.total, meta.hasMore)
GET {{host}}/products?limit=6&offset=6

### Некорректный limit -> 400
GET {{host}}/products?limit=0

###
GET {{host}}/products/999

###
GET {{host}}/products/abc

### Покупатель не может добавлять товары -> 403
POST {{host}}/products
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "title": "Куртка бомбер",
  "category": "jackets",
  "sizes": ["S", "M", "L"],
  "color": "хаки",
  "price": 129.9,
  "stock": 10
}

### Администратор добавляет товар -> 201
# @name createdProduct
POST {{host}}/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Куртка бомбер",
  "category": "jackets",
  "sizes": ["S", "M", "L"],
  "color": "хаки",
  "price": 129.9,
  "stock": 10
}

###
@productId = {{createdProduct.response.body.data.id}}

###
POST {{host}}/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "title": "Куртка бомбер" }

###
PUT {{host}}/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Куртка бомбер зимняя",
  "category": "jackets",
  "sizes": ["M", "L"],
  "color": "чёрный",
  "price": 179.9,
  "stock": 6
}

# ===== Корзина (у каждого пользователя своя) =====

### Без токена -> 401
GET {{host}}/cart

###
GET {{host}}/cart
Authorization: Bearer {{userToken}}

###
POST {{host}}/cart/items
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "productId": {{productId}}, "size": "L", "quantity": 2 }

###
POST {{host}}/cart/items
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "productId": {{productId}}, "size": "XXL", "quantity": 1 }

###
POST {{host}}/cart/items
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "productId": {{productId}}, "size": "M", "quantity": 99 }

###
PUT {{host}}/cart/items/1
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "quantity": 3 }

### Смена размера позиции (лаб. №25); размер должен быть у товара и не дублировать другую позицию
PUT {{host}}/cart/items/1
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "size": "M" }

### Количество больше остатка на складе -> 409
PUT {{host}}/cart/items/1
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "quantity": 9999 }

###
DELETE {{host}}/cart/items/1
Authorization: Bearer {{userToken}}

# ===== Заказы =====

### Оформление заказа (email по умолчанию берётся из токена)
# @name createdOrder
POST {{host}}/orders
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "customer": {
    "name": "Иван Петров",
    "phone": "+375291234567",
    "address": "г. Минск, ул. Независимости, 25, кв. 14"
  }
}

###
@orderId = {{createdOrder.response.body.data.id}}

### Покупатель видит только свои заказы
GET {{host}}/orders
Authorization: Bearer {{userToken}}

### Администратор видит все заказы
GET {{host}}/orders?status=new
Authorization: Bearer {{adminToken}}

### Покупатель не может менять статус -> 403
PATCH {{host}}/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{userToken}}

{ "status": "paid" }

###
PATCH {{host}}/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "status": "paid" }

###
PATCH {{host}}/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "status": "wrong" }

###
DELETE {{host}}/orders/{{orderId}}
Authorization: Bearer {{adminToken}}

# ===== Пользователи (только admin) =====

### Покупатель -> 403
GET {{host}}/users
Authorization: Bearer {{userToken}}

###
GET {{host}}/users
Authorization: Bearer {{adminToken}}

### Назначить роль (подставьте id пользователя)
PATCH {{host}}/users/2/role
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "role": "admin" }

###
DELETE {{host}}/products/{{productId}}
Authorization: Bearer {{adminToken}}

###
GET {{host}}/unknown

###
GET http://localhost:3000/
